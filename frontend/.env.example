# ==================================================================================================================
# ElDesparche — Configuración del frontend (Vite)
# ==================================================================================================================
# Copia a .env solo si necesitas cambiar algo: sin este archivo la web usa /api y Vite lo redirige a localhost:5000.
# La web NUNCA se conecta a la base de datos (ni a Neon): solo habla con el API. La cadena de conexión de Neon va en
# backend/.env (DATABASE_URL) y no debe aparecer aquí: todo lo que empieza con VITE_ queda visible en el navegador.

# Backend al que el servidor de desarrollo (npm run dev) redirige /api y /uploads. Por defecto http://localhost:5000
# API_PROXY_TARGET=http://localhost:5000

# Dirección del API cuando la web publicada (npm run build) y el API están en dominios distintos.
# Si se deja vacía, la web llama a /api en su mismo dominio (con un proxy inverso que envíe /api al backend).
# Si se usa, agrega este origen a CORS_ORIGIN en backend/.env.
# VITE_API_URL=https://api.eldesparche.online/api
