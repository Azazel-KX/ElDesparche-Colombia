{
  "name": "eldesparche-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de ElDesparche (Express + PostgreSQL, patrón MVC)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "bd:cargar": "node scripts/cargarBd.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:cobertura": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/** \"test/*.test.js\"",
    "test:bd": "node scripts/pruebasBd.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
