# ==================================================================================================================
# ElDesparche — Configuración de Entorno
# ==================================================================================================================
# Este archivo es un EJEMPLO. Copia a .env y reemplaza los valores según tu entorno.
# NUNCA subas .env al repositorio (está en .gitignore)

# ==================================================================================================================
# MODO DE OPERACIÓN
# ==================================================================================================================
NODE_ENV=development

PORT=5000

# ==================================================================================================================
# BASE DE DATOS - OPCIÓN 1: LOCAL
# ==================================================================================================================

DB_HOST=localhost
DB_PORT=5432
# Valores del docker-compose.yml de la raíz (base desparche_db, usuario postgres, contraseña admin)
DB_NAME=desparche_db
DB_USER=postgres
DB_PASSWORD=admin

# ==================================================================================================================
# BASE DE DATOS - OPCIÓN 2: NEON (descomenta cuando migres; si existe, se ignoran las DB_* de arriba)
# ==================================================================================================================
# Copia la cadena tal cual de la consola de Neon (Connect → Connection string). Ver GUIA_NEON.md.
# Se conecta con SSL verificando el certificado; channel_binding=require se respeta.

# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# SSL forzado (true) o apagado (false). Por defecto: lo que diga sslmode en la URL; sin sslmode, SSL salvo en localhost
# DB_SSL=true

# Pool de conexiones (valores por defecto). El tiempo de conexión es amplio porque Neon tarda unos segundos en despertar
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=30000

# Zona horaria de las consultas (las fechas se guardan en hora de Colombia). Por defecto America/Bogota
# DB_TIMEZONE=America/Bogota

# ==================================================================================================================
# AUTENTICACIÓN JWT
# ==================================================================================================================

JWT_SECRET=tu_secreto_muy_largo_y_seguro_minimo_32_caracteres_aleatorios
JWT_EXPIRES_IN=2h

# ==================================================================================================================
# CORS
# ==================================================================================================================

CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Dirección pública del API (para la URL de las imágenes de eventos y logos). Por defecto http://localhost:PORT
# PUBLIC_URL=http://localhost:5000

# ==================================================================================================================
# IMÁGENES EN LA NUBE - CLOUDFLARE R2 (opcional)
# ==================================================================================================================
# Sin estas cinco variables, las imágenes que suben los paneles se guardan en backend/uploads (se pierden en hostings
# con disco temporal, como Render gratis). Con ellas se suben al bucket de R2 y la web las pide directo a R2_PUBLIC_URL.
# Las claves se crean en Cloudflare -> R2 -> Manage R2 API Tokens (permiso Object Read & Write sobre el bucket).

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=eldesparche-imagenes
# R2_PUBLIC_URL=https://cdn.eldesparche.online

# ==================================================================================================================
# LOG
# ==================================================================================================================

LOG_LEVEL=debug
