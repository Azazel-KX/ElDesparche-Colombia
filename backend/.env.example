# Copia este archivo a backend/.env y ajusta los valores (el .env no se sube a git).
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=desparche_db
DB_USER=postgres
DB_PASSWORD=admin

# Token de sesión (JWT). Usa un valor largo y aleatorio; sin él el servidor no arranca.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Origen del frontend permitido por CORS (Vite usa 5173, `serve` usa 4173)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Simulación de biometría para entorno universitario
BIOMETRIC_MOCK_MODE=true
