        <mxCell id="Mq6hkwXfZcYeHEss-Ytd-477" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="activo" vertex="1">
